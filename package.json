{
  "name": "shopee-review",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "dotenv -e .env -- pnpm --filter @app/database generate",
    "db:migrate": "dotenv -e .env -- pnpm --filter @app/database migrate:dev",
    "db:deploy": "dotenv -e .env -- pnpm --filter @app/database migrate:deploy",
    "db:seed": "dotenv -e .env -- pnpm --filter @app/database seed"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "turbo": "^2.5.8",
    "typescript": "^5.8.3"
  },
  "packageManager": "pnpm@10.28.2",
  "pnpm": {
    "overrides": {
      "proxy-addr": "^2.0.8",
      "lodash": "^4.18.1",
      "@nestjs/platform-express>multer": "^2.3.0",
      "minimatch@10>brace-expansion": "^5.0.12",
      "fast-uri": "^3.1.7",
      "postcss": "^8.5.18",
      "socket.io-parser": "^4.2.7",
      "nanoid": "^3.3.18",
      "browserslist": "^4.28.7",
      "engine.io": "^6.6.10",
      "source-map-js": "^1.2.2"
    }
  }
}
